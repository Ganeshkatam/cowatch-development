# ==========================================
# CoWatch Environment Configuration Template
# ==========================================

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true

# Invite credential signing secret (required; generate with: openssl rand -hex 32)
INVITE_CREDENTIAL_SECRET=replace_with_a_random_32_byte_secret

# Passcode fingerprint secret (required; generate with: openssl rand -hex 32)
PASSCODE_FINGERPRINT_KEY=replace_with_a_random_32_byte_secret

# Optional PostgreSQL TLS hardening
# DATABASE_SSL_STRICT=true
# DATABASE_SSL_CA=/path/to/ca.pem

# Supabase Server Auth (Backend)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Supabase Client Auth (Frontend)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Frontend Server Connection (Set in Vercel)
# VITE_SERVER_HOST=https://your-backend.up.railway.app

# Optional Services
# REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
# YOUTUBE_API_KEY=your_youtube_api_key