# ==========================================
# CoWatch Environment Configuration Template
# ==========================================

# Server Configuration
# PORT=8080
# HOST=0.0.0.0

# Database (PostgreSQL via Supabase)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true

# Invite credential signing secret (required; generate with: openssl rand -hex 32)
# INVITE_CREDENTIAL_SECRET=replace_with_a_random_32_byte_secret

# Passcode fingerprint secret (required; generate with: openssl rand -hex 32)
# PASSCODE_FINGERPRINT_KEY=replace_with_a_random_32_byte_secret

# Optional PostgreSQL TLS hardening
# DATABASE_SSL_STRICT=true
# DATABASE_SSL_CA=/path/to/ca.pem

# Supabase Server Auth (Backend)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Supabase Client Auth (Frontend)
# VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Frontend Server Connection (Set in Vercel)
# VITE_SERVER_HOST=https://your-domain

# Optional Services
# REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
# YOUTUBE_API_KEY=your_youtube_api_key

# ==========================================
# VBrowser (Virtual Browser) Configuration
# ==========================================
# VBrowser requires at least one VM provider to be configured.
# You can use Docker (for local development) or Cloud Providers (for production).

# 1. Docker (Local Development)
# DOCKER_VM_HOST=localhost
# DOCKER_VM_HOST_SSH_USER=root
# DOCKER_VM_HOST_SSH_KEY_BASE64=your_base64_encoded_private_key

# 2. DigitalOcean
# DO_TOKEN=your_digitalocean_api_token
# DO_GATEWAY=your_gateway_ip
# DO_IMAGE=your_snapshot_image_id
# DO_SSH_KEYS=your_ssh_key_ids_comma_separated

# 3. Hetzner
# HETZNER_TOKEN=your_hetzner_api_token
# HETZNER_GATEWAY=your_gateway_ip
# HETZNER_IMAGE=your_snapshot_image_id
# HETZNER_SSH_KEYS=your_ssh_key_ids_comma_separated

# 4. Scaleway
# SCW_SECRET_KEY=your_scaleway_secret_key
# SCW_ORGANIZATION_ID=your_organization_id
# SCW_GATEWAY=your_gateway_ip
# SCW_IMAGE=your_snapshot_image_id

# Advanced VBrowser Settings
# VBROWSER_SESSION_SECONDS=10800
# VBROWSER_TAG=cowatch-vbrowser
# VITE_VBROWSER_ENABLED=false # Set to false to hide VBrowser from the UI